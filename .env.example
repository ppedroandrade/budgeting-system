# Copie para .env.local (no computador) ou cadastre na Vercel (Settings → Environment Variables).
# Valores em: Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-public-key
# SECRETA: nunca compartilhe. Usada só no servidor para cadastrar vendedores.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key
